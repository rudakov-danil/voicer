# ============================================================
# VoiceIQ — пример конфига окружения
# Скопируй в .env и заполни своими значениями
# Сгенерировать случайные секреты: openssl rand -hex 32
# ============================================================

# ─── База данных ─────────────────────────────────────────────
POSTGRES_PASSWORD=ЗАМЕНИ_НА_НАДЁЖНЫЙ_ПАРОЛЬ

# ─── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_PASSWORD=ЗАМЕНИ_НА_НАДЁЖНЫЙ_ПАРОЛЬ

# ─── MinIO (объектное хранилище аудио) ───────────────────────
MINIO_ACCESS_KEY=voiceiq
MINIO_SECRET_KEY=ЗАМЕНИ_НА_НАДЁЖНЫЙ_ПАРОЛЬ

# ─── JWT ─────────────────────────────────────────────────────
# Минимум 32 символа, случайная строка
JWT_SECRET=ЗАМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ_32_СИМВОЛА

# ─── Service-to-service auth ─────────────────────────────────
# Внутренний ключ для авторизации воркеров между сервисами
INTERNAL_SERVICE_KEY=ЗАМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ

# ─── Панель управления (/admin) ──────────────────────────────
ADMIN_PANEL_PASSWORD=ЗАМЕНИ_НА_ПАРОЛЬ
GRAFANA_PASSWORD=ЗАМЕНИ_НА_ПАРОЛЬ

# ─── Первый суперадмин (создаётся при первом запуске) ────────
# Если пользователь с таким email уже есть — bootstrap его не трогает.
BOOTSTRAP_ADMIN_EMAIL=admin@demo.ru
BOOTSTRAP_ADMIN_PASSWORD=Test1234!
BOOTSTRAP_ORG_NAME=Demo
BOOTSTRAP_ORG_SLUG=demo

# ─── Deepgram (STT API) ──────────────────────────────────────
# Ключ из консоли Deepgram (https://console.deepgram.com)
DEEPGRAM_API_KEY=ЗАМЕНИ_НА_СВОЙ_КЛЮЧ_DEEPGRAM
# Параметры модели — менять обычно не нужно
DEEPGRAM_API_URL=https://api.deepgram.com/v1/listen
DEEPGRAM_LANGUAGE=ru
DEEPGRAM_MODEL=nova-3

# ─── LLM (Yandex Cloud — YandexGPT) ──────────────────────────
# OpenAI-совместимый endpoint Yandex Cloud Foundation Models.
# Документация: https://yandex.cloud/docs/foundation-models/concepts/openai-compatibility
# Получить API-ключ сервисного аккаунта: https://yandex.cloud/docs/iam/operations/api-key/create
LLM_SERVER_URL=https://llm.api.cloud.yandex.net
LLM_API_KEY=ЗАМЕНИ_НА_API_КЛЮЧ_YANDEX_CLOUD
# Идентификатор каталога (folder) — параметр project клиента
LLM_FOLDER_ID=ЗАМЕНИ_НА_FOLDER_ID
LLM_EXTRA_HEADER_NAME=
LLM_EXTRA_HEADER_VALUE=
# Модель задаётся в формате gpt://<folder_id>/<model>/<version>.
# Подставь свой LLM_FOLDER_ID вместо b1gf1jcj68slj24b1be7.
# Варианты: qwen3.6-35b-a3b/latest (точнее) | yandexgpt-5-lite/latest | yandexgpt/latest
LLM_MODEL_NAME=gpt://b1gf1jcj68slj24b1be7/qwen3.6-35b-a3b/latest
LLM_SCRIPT_TIMEOUT=60
LLM_GENERAL_TIMEOUT=60
LLM_MAX_PARALLEL_SCRIPTS=1
LLM_MAX_TOKENS=1024
# Оптимизация токенов: объединять общий анализ и комплаенс в один LLM-вызов
# (транскрипт не пересылается дважды). При любом сбое — авто-откат на раздельные
# вызовы. Чтобы отключить и вернуть прежнее поведение — поставь false.
LLM_MERGE_ANALYSIS=true
# Необязательная дешёвая модель для тривиальных проходов (скрининг скриптов,
# анонимизация ПД). Пусто → используется основная LLM_MODEL_NAME.
# Пример: gpt://<folder_id>/gpt-oss-20b/latest
LLM_CHEAP_MODEL=

# ─── LLM (альтернатива: OpenRouter cloud API) ────────────────
# Чтобы вернуться на OpenRouter — закомментируй блок Yandex выше,
# раскомментируй строки ниже и очисти LLM_FOLDER_ID (оставь пустым).
# Ключ: https://openrouter.ai/keys · Каталог: https://openrouter.ai/models
# LLM_SERVER_URL=https://openrouter.ai/api
# LLM_API_KEY=ЗАМЕНИ_НА_КЛЮЧ_OPENROUTER
# LLM_FOLDER_ID=
# LLM_MODEL_NAME=mistralai/mistral-small-3.2-24b-instruct
