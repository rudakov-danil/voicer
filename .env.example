# ============================================================
# VoiceIQ — пример конфига окружения
# Скопируй в .env и заполни своими значениями
# ============================================================

# База данных
POSTGRES_PASSWORD=ЗАМЕНИ_НА_НАДЁЖНЫЙ_ПАРОЛЬ

# RabbitMQ
RABBITMQ_PASSWORD=ЗАМЕНИ_НА_НАДЁЖНЫЙ_ПАРОЛЬ

# MinIO (объектное хранилище аудио)
MINIO_ACCESS_KEY=ЗАМЕНИ
MINIO_SECRET_KEY=ЗАМЕНИ_НА_НАДЁЖНЫЙ_ПАРОЛЬ

# JWT — минимум 32 символа, случайная строка
JWT_SECRET=ЗАМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ_32_СИМВОЛА

# Внутренний ключ для service-to-service auth
INTERNAL_SERVICE_KEY=ЗАМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ

# Whisper (GPU-сервер транскрипции)
WHISPER_SERVER_URL=http://IP_GPU_СЕРВЕРА:8080

# LLM — 1BitAI cloud API
LLM_SERVER_URL=https://llm.1bitai.ru
LLM_MODEL_NAME=qwen2.5:14b
LLM_API_KEY=1bitai
LLM_EXTRA_HEADER_NAME=X-PROXY-AUTH
LLM_EXTRA_HEADER_VALUE=ТВОЙ_КЛЮЧ_1BITAI
LLM_SCRIPT_TIMEOUT=120
LLM_GENERAL_TIMEOUT=120
