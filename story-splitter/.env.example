# Ключ Deepgram. Казахский (kk) умеет модель nova-3 в batch-режиме.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
ASR_LANGUAGE=kk

# LLM — любой OpenAI-совместимый эндпоинт (Yandex Cloud / OpenRouter / Ollama).
# Значения можно взять из основного .env проекта Voicer.
LLM_SERVER_URL=https://llm.api.cloud.yandex.net
LLM_API_KEY=
LLM_FOLDER_ID=
LLM_MODEL_NAME=
LLM_MAX_TOKENS=8192
# Отключает reasoning у think-моделей (qwen3 и т.п.). Без этого модель
# тратит весь лимит токенов на размышление и возвращает пустой ответ.
LLM_DISABLE_THINKING=true

# Показывать русский перевод рядом с казахским оригиналом
TRANSLATE_TO_RU=true
# Фрагменты короче этого числа секунд историями не считаются
STORY_MIN_SEC=20
